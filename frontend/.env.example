# Copy to .env.local and fill in your values:
#   cp .env.example .env.local
#
# For local dev, you can instead set these in the repo-root .env (Next loads both).

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth web client ID (required for "Continue with Google" on login/signup)
# If unset, Next.js falls back to GOOGLE_CLIENT_ID from the repo-root .env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Backend API (optional; defaults to http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public site URL for share previews (optional; auto-detected from request host if unset)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Stripe monthly prices are read from repo-root .env (STRIPE_PRICE_*_MONTHLY).
# Next.js loads the root .env via next.config.js — no duplicate keys needed here.
