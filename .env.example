# Copy to .env in the project root and fill in your values:
#   cp .env.example .env

# --- Database & Supabase ---
# Transaction pooler (port 6543) — copy URI from Supabase → Database → Connection string
DATABASE_POOLER=transaction
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# TLS: uses certifi CA bundle by default on Windows/macOS (DB_SSL_CA_FILE optional)
DB_SSL_VERIFY=true

# Supabase JS client (Project Settings → API → anon public key)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- API ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public URL for Twilio webhooks (use ngrok HTTPS URL in local dev)
PUBLIC_API_URL=http://localhost:8000

# --- Twilio Voice (CallGuard phone UI) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=+15551234567
# User UUID that receives inbound browser calls (from your users table)
TWILIO_DEFAULT_USER_ID=
TWILIO_VOICE_PIN=
# Required for live speech-to-text on calls (Whisper)
OPENAI_API_KEY=

# --- Stripe (monthly list prices; used by pricing UI and checkout) ---
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE_MONTHLY=2.99
STRIPE_PRICE_CORE_MONTHLY=5.99
STRIPE_PRICE_PREMIUM_MONTHLY=15.99
STRIPE_PRICE_FAMILY_MONTHLY=19.99
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SUCCESS_URL=http://localhost:3000/profile?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/profile
