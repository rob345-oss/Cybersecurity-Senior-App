# Titanium Guardian API - Environment Configuration
# Copy this file to the project root as .env and update with your actual values

# Transaction pooler (Supabase → Database → Connection string, port 6543)
DATABASE_POOLER=transaction
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase client (Project Settings → API; anon key is safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API Authentication
# Optional: API key for securing the API endpoints
# If not set, API authentication is disabled (development mode only)
# Generate a secure random key for production use
API_KEY=

# Session Management
# Session time-to-live in hours
# Default: 24 hours
# Set to 0 to disable session expiration
SESSION_TTL_HOURS=24
